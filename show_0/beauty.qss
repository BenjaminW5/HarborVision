QWidget#Form
{
	background:#464646;
}
QPushButton#pb1
{
	background:#383838;
	border-image:url(./pic/red_cir.png);
}
QPushButton#pb2
{
	background:#383838;
	border-image:url(./pic/yel_cir.png);
}
QPushButton#pb3
{
	background:#383838;
	border-image:url(./pic/gre_cir.png);
}



QPushButton#detect,QPushButton#settings,QPushButton#save
{
	border:none;
	color:white;
	border-top-right:20px;
	border-bottom-right:20px;
}
QPushButton#detect:hover,QPushButton#settings:hover,QPushButton#save:hover
{
	border-left:6px solid white;
	color:#white;
	background-color:#616F76;
}
QPushButton#detect:pressed,QPushButton#settings:pressed,QPushButton#save:pressed
{
	border-left:6px solid white;
	color:#383838;
	background-color:#B3EE3A;
}
QWidget#left
{
	background:#383838;
	border-top:1px solid white;
	border-left:1px solid white;
	border-bottom:1px solid white;
	border-top-left-radius:20px;
	border-bottom-left-radius:20px;
}
QWidget#right
{
	background:#636363;
	border-top:1px solid white;
	border-right:1px solid white;
	border-bottom:1px solid white;
	border-top-right-radius:20px;
	border-bottom-right-radius:20px;
}



QPushButton#camera
{
	background:#636363;
	image:url(./pic/camera.png);
	border:3px solid #464646;
	border-radius:10px;
}
QPushButton#file
{
	background:#636363;
	image:url(./pic/video.png);
	border:3px solid #464646;
	border-radius:10px;
}
QPushButton#pt
{
	background:#636363;
	image:url(./pic/n.png);
	border:3px solid #464646;
	border-radius:10px;
}
QPushButton#camera:hover, QPushButton#camera:hover:pressed
{
	background:#636363;
	image:url(./pic/camera.png);
	border:3px solid #B3EE3A;
}
QPushButton#file:hover, QPushButton#file:hover:pressed
{
	background:#636363;
	image:url(./pic/video.png);
	border:3px solid #B3EE3A;
}
QPushButton#pt:hover, QPushButton#pt:hover:pressed
{
	background:#636363;
	image:url(./pic/n.png);
	border:3px solid #B3EE3A;
}


QPushButton#start,QPushButton#start:pressed
{
	background:#636363;
	border-image:url(./pic/start2.png);
}
QPushButton#end,QPushButton#end:pressed
{
	background:#636363;
	border-image:url(./pic/stop.png);
}

QPushButton#pause,QPushButton#pause:pressed
{
	background:#636363;
	border-image:url(./pic/start1.png);
}
QPushButton#start:hover
{
	background:#636363;
	image:url(./pic/start2.png);
	border:3px solid #464646;
	border-radius:10px;
}
QPushButton#end:hover
{
	background:#636363;
	border-image:url(./pic/stop.png);
	border:3px solid #464646;
	border-radius:10px;
}

QPushButton#pause:hover
{
	background:#636363;
	border-image:url(./pic/start1.png);
	border:3px solid #464646;
	border-radius:10px;
}

QPushButton#voice
{
	background:#636363;
	border-image:url(./pic/voice.png);
}
QLineEdit#file_location
{
    border:1px solid gray;
    border-radius:10px;
    padding:2px 4px;
    background-color:#464646;
}



QSlider::handle
{
	image:url(./pic/slider.png);
}


QLabel, QLineEdit
{
	color:white;
}
QTextEdit, QLineEdit
{
	background:#464646;
	border:1px solid gray;
	border-radius:10px;
}
QWidget#right_center
{
	background:#464646;
	border-radius:10px;
}
QCheckBox::indicator:checked
{
	width:40px;
	height:40px;
	image:url(./pic/checked)
}
QCheckBox::indicator:unchecked
{
	width:40px;
	height:40px;
	image:url(./pic/unchecked)
}
